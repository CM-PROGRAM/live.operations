              "hoursInterval": 1
            }
          ]
        }
      },
      "name": "A cada 1 hora",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -720,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=PREENCHER_URL_DO_LOGIN",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "email",
              "value": "={{ $env.MANDABEM_USUARIO }}"
            },
            {
              "name": "password",
              "value": "={{ $env.MANDABEM_SENHA }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "name": "Login Manda Bem",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -520,
        460
      ]
    },
    {
      "parameters": {
        "jsCode": "/* Guarda o cookie da sessão para os nós do painel reaproveitarem.\n   Sem captcha no login, o n8n renova sozinho a cada rodada — ninguém\n   precisa colar cookie à mão quando expirar. */\nconst h = $input.first().json.headers || {};\nconst bruto = h['set-cookie'] || h['Set-Cookie'] || [];\nconst cookie = (Array.isArray(bruto) ? bruto : [bruto])\n  .map(c => String(c).split(';')[0]).join('; ');\nif (!cookie) throw new Error('Login do Manda Bem não devolveu cookie — confira usuário e senha');\nreturn [{ json: { cookie } }];"
      },
      "name": "Guardar cookie",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -320,
        460
      ]
    },
    {
      "parameters": {
        "url": "https://suplelive-8a700-default-rtdb.firebaseio.com/suplelive/reg/rastreios.json",
        "options": {}
      },
      "name": "Ler Live Track",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -520,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Entrada: o objeto inteiro de rastreios. Saída: só o que vale consultar agora.\nconst todos = $input.first().json || {};\nconst agora = Date.now();\nconst DIAS_ATE_DESISTIR = 45;\n\nconst fila = Object.entries(todos).map(([chave, r]) => ({ chave, ...r })).filter(r => {\n  if (!r || !r.codigo) return false;                    // sem código não há o que consultar\n  if (r.status === 'Entregue') return false;            // trabalho encerrado\n  if (r.trackProximaConsulta && agora < r.trackProximaConsulta) return false; // backoff\n\n  // Pacote parado há mais de 45 dias não volta a andar porque perguntamos de\n  // novo. Sai da fila e vira problema humano, não de robô.\n  const nasceu = Number(r.ordemManual || 0);\n  if (nasceu && (agora - nasceu) > DIAS_ATE_DESISTIR * 864e5) return false;\n\n  return true;\n});\n\nreturn fila.map(json => ({ json }));\n"
      },
      "name": "Fila de consulta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -320,
        300
      ]
    },
    {
      "parameters": {
        "batchSize": 10,
        "options": {}
      },
      "name": "Lotes de 10",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        -100,
        300
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.intermediador }}",
                    "rightValue": "Melhor Envio",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "outputKey": "Melhor Envio"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.intermediador }}",
                    "rightValue": "Manda Bem",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "outputKey": "Manda Bem"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "Sem fonte"
        }
      },
      "name": "Por intermediador",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        120,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://melhorenvio.com.br/api/v2/me/shipment/tracking",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.MELHORENVIO_TOKEN }}"
