              "value": "application/json"
            },
            {
              "name": "User-Agent",
              "value": "LiveOps (contato@suplelive.com.br)"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ orders: [$json.envioId] }) }}",
        "options": {}
      },
      "name": "Melhor Envio · rastreio",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        380,
        140
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "url": "=PREENCHER_URL_DO_DETALHE/{{ $json.envioId || $json.coletaId }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Cookie",
              "value": "={{ $('Guardar cookie').first().json.cookie }}"
            },
            {
              "name": "X-Requested-With",
              "value": "XMLHttpRequest"
            }
          ]
        },
        "options": {}
      },
      "name": "Manda Bem · detalhe",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        380,
        400
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// O HTML do detalhe traz o botão da lupa com o endereço do rastreio pronto.\n// Ler daqui vale mais que qualquer tabela de slugs: funciona para\n// transportadora que ainda nem existe no cadastro.\nconst html = $json.html || '';\nconst m = html.match(/class=\"btn-get-status-objeto-envio\"[^>]*data-path=\"([^\"]+)\"/)\n       || html.match(/data-path=\"([^\"]*status[^\"]*objeto[^\"]*)\"/);\nreturn { json: { ...$json, trackUrl: m ? m[1].replace(/\\\\\\//g, '/') : '' } };\n"
      },
      "name": "Extrai o data-path",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        400
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.trackUrl }}",
        "sendHeaders": true,
        "headerParameters": {
