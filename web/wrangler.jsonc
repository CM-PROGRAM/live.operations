{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "live-operations",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Sem isto o wrangler injeta `__name(...)` nas funções, e as que o Next
  // manda como script para o navegador (o do tema) quebram lá
  "keep_names": false,
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  // Endereço público, usado no link do e-mail de "Esqueci minha senha".
  // Os segredos (DATABASE_URL, RESEND_API_KEY) ficam só na Cloudflare.
  "vars": { "APP_URL": "https://live-operations.carlosmagnoav94.workers.dev" }
}
