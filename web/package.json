{
  "name": "liveops-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrar": "tsx scripts/migrar.ts",
    "db:usuarios": "tsx scripts/usuarios.ts",
